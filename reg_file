module reg_file(
    A1,
    A2,
    A3,
    WD3,
    WE3,
    clk,
    rst,
    RD1,
    RD2
);
    input clk;
    input rst;

    input [31:0] WD3;
    input [4:0] A1;
    input [4:0] A2;
    input [4:0] A3;
    input WE3;


    output [31:0] RD1;
    output [31:0] RD2;


    reg [31:0] Registers [31:0];

    integer i;

//write
    always @(posedge clk or posedge rst)
    begin
        if(rst)
        begin
            for(i = 0; i < 32; i = i + 1)
                Registers[i] <= 32'h00000000;
        end

        else
        begin
            // Write data into register
            if(WE3 && (A3 != 5'b00000))
                Registers[A3] <= WD3;

            Registers[0] <= 32'h00000000;
        end
    end


    // Read functionality

    assign RD1 = (rst == 1'b1) ? 32'h00000000 :
                 (A1 == 5'b00000) ? 32'h00000000 :
                 Registers[A1];

    assign RD2 = (rst == 1'b1) ? 32'h00000000 :
                 (A2 == 5'b00000) ? 32'h00000000 :
                 Registers[A2];


endmodule
